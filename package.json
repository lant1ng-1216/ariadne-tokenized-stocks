{
  "name": "ariadne-tokenized-stocks",
  "version": "0.1.0",
  "private": false,
  "description": "AI-native interaction infrastructure for tokenized equities and real-world assets on BNB Chain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lant1ng-1216/ariadne-tokenized-stocks.git"
  },
  "homepage": "https://github.com/lant1ng-1216/ariadne-tokenized-stocks",
  "files": [
    "dist-package",
    "README.md",
    "LICENSE",
    "docs/SDK_USAGE.md",
    "docs/QUICKSTART.md"
  ],
  "main": "./dist-package/index.js",
  "types": "./dist-package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-package/index.d.ts",
      "import": "./dist-package/index.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
