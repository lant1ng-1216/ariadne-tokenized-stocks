    "test:signed-transaction": "node --import tsx scripts/test-signed-transaction.ts",
    "test:input-balance": "node --import tsx scripts/test-input-balance.ts",
    "test:gas-safety": "node --import tsx scripts/test-gas-safety.ts",
    "test:execution-dry-run": "node --import tsx scripts/test-execution-dry-run.ts",
    "test:guarded-sdk-executor": "node --import tsx scripts/test-guarded-sdk-executor.ts",
    "test:agent-model": "node --import tsx scripts/test-agent-model.ts",
    "test:asset-intent-query": "node --import tsx scripts/test-asset-intent-query.ts",
    "test:mcp-natural-language": "node --env-file=.env --import tsx scripts/test-mcp-natural-language.ts",
    "test:mcp-enrichment": "node --import tsx scripts/test-mcp-enrichment.ts",
    "test:mcp-app-ui": "node --import tsx scripts/test-mcp-app-ui.ts",
    "test:mcp-live-catalog-warning": "node --import tsx scripts/test-mcp-live-catalog-warning.ts",
    "test:core-hardening": "node --import tsx scripts/test-core-hardening.ts",
    "test:core-product-phase-plan": "node --import tsx scripts/test-core-product-phase-plan.ts",
    "test:phase26-limitations": "node --import tsx scripts/test-phase26-provider-limitations.ts",
    "test:presentation": "node --import tsx scripts/test-presentation-contract.ts",
    "test:web-workspace": "node --import tsx scripts/test-web-workspace.ts",
    "test:web-catalog-client": "node --import tsx apps/web/scripts/test-catalog-client.ts",
