BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build
# Optional: only set if the machine's network requires an outbound HTTP proxy.
# This is mapped to the SDK proxyUrl option; it is not the generic HTTPS_PROXY variable.
BINANCE_WEB3_PROXY_URL=
# Optional BSC JSON-RPC endpoint used for read-only ERC-20 allowance checks.
BINANCE_WEB3_EVM_RPC_URL=https://bsc-dataseed.binance.org
# Optional public Reown Project ID for the in-panel WalletConnect QR flow (create one in the Reown Dashboard).
ARIADNE_REOWN_PROJECT_ID=
# Optional external wallet approval relay. Both Ariadne MCP and the relay use the same private service secret.
# Production requires one stable HTTPS origin; http://127.0.0.1 is accepted only for local loopback testing.
ARIADNE_WALLET_HANDOFF_RELAY_URL=
ARIADNE_WALLET_HANDOFF_RELAY_SECRET=
# Relay process only: public origin served behind an HTTPS reverse proxy and private session store path.
ARIADNE_WALLET_HANDOFF_PORTAL_ORIGIN=
ARIADNE_WALLET_HANDOFF_STORE_PATH=data/ariadne-wallet-handoff/sessions.json
